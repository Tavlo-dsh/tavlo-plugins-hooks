{
  "name": "@tavlo-dsh/dsh-plugin-hooks",
  "version": "0.1.2",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "description": "DSH Hook 通知与脚本扩展插件：支持全事件 Hook 挂载、应用内/系统/任务栏提醒、自定义 WAV 铃声、跨平台脚本与 11 种三方通知渠道",
  "license": "MIT",
  "author": "Tavlo-dsh",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/*.js",
    "lib/client.js",
    "lib/client.js.LEGAL.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "hooks",
    "notifications",
    "tavlo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node --check index.js && node --check src/hook-catalog.js && node --check src/default-scripts.js && node --check src/config-store.js && node --check src/script-runner.js && node --check src/dsh-hook-bridge.js && node --check src/event-hub.js && node --check src/sound-manager.js && node --check src/system-notifier.js && node --check src/third-party-providers.js && node --check src/notification-dispatcher.js && node scripts/build-client.mjs && node --check lib/client.js",
    "test": "node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.2-rc.1",
    "esbuild": "0.28.2",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
